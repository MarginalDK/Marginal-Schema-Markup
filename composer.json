{
	"name": "marginaldk/marginal-schema-markup",
	"description": "WordPress-plugin til global og side-specifik JSON-LD schema markup.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"install-wp": "bash tests/bin/install-wp.sh",
		"test": "phpunit",
		"lint": "phpcs",
		"check": [
			"@lint",
			"@test"
		]
	}
}
