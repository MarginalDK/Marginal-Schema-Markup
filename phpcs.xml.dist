<?xml version="1.0"?>
<ruleset name="Marginal Schema Markup">
	<description>Sikkerheds- og kompatibilitetstjek. Kører i CI.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/.wp-tests/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Pluginnet skal kunne køre på PHP 7.4 og nyere. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.0"/>

	<!-- Sikkerhed: escaping, nonces, input-sanering, redirects, SQL. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedClasses"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="marginal_schema"/>
				<element value="Marginal_Schema"/>
				<element value="MARGINAL_SCHEMA"/>
			</property>
		</properties>
	</rule>
	<rule ref="Generic.PHP.BacktickOperator"/>
	<rule ref="Squiz.PHP.Eval"/>
</ruleset>
